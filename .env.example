# Pre-launch gate — see src/proxy.ts
#
# Leave SITE_LAUNCHED unset (or anything but "true") and every route shows the
# coming-soon page. Set it to "true" on launch day to open the whole site.
SITE_LAUNCHED=false

# Optional. While gated, visiting any URL with ?preview=<this value> sets a
# cookie that lets you browse the real site. Leave blank to disable previews.
PREVIEW_TOKEN=

# Where the "Want us to reach out?" form on /coming-soon sends each lead as
# JSON — a Google Apps Script web app, a Zapier/Make catch hook, a Slack
# incoming webhook, etc. Unset = leads only go to the server log.
LEAD_WEBHOOK_URL=

# --- Optional: email each lead (via Resend, https://resend.com) ---
# RESEND_API_KEY + LEAD_EMAIL_TO is all you need to start. LEAD_EMAIL_FROM
# defaults to Resend's shared test address; for production set it to an address
# on a domain you've verified in Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_CC=
LEAD_EMAIL_FROM=

# --- Optional: also send each lead as a WhatsApp message (Meta Cloud API) ---
# Requires a WhatsApp Business Platform app with its OWN sender number — this
# CANNOT be the number people message from the site (you can't WhatsApp
# yourself). WHATSAPP_NOTIFY_TO is where the alert lands: a team member's
# number, international format, digits only (e.g. 27821234567).
# Without WHATSAPP_TEMPLATE it sends plain text, which Meta only delivers if
# that person messaged the sender in the last 24h. Set WHATSAPP_TEMPLATE to an
# approved 2-variable template name for reliable delivery.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
